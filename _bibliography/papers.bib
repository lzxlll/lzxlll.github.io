@article{liu2026patent_quality,
  title     = {中国专利质量的测度、变化机制与经济增长效应},
  author    = {Liu, Zexuan and Chen, Zhiyuan and Zhang, Yiran and Zhang, Jie},
  journal   = {经济研究 (Economic Research Journal)},
  year      = {2026},
  number    = {03},
  abbr      = {经济研究},
  selected  = {true},
  bibtex_show = {true},
  preview   = {jjyj.jpg},
  abstract  = {如何构建有效测算中国专利质量的方法体系，既是该领域的前沿问题之一，也是事关中国如何全面落实创新驱动发展战略的基础性工作。本文利用1985—2021年期间中国发明专利文本信息，运用自然语言处理方法，在计算符合中国专利间文本相似度这一核心指标的基础上，探讨了适用于中国专利数据特征的专利质量测算方法。各项可靠性检验均验证了本文设计和测算的专利质量指标变量相较于传统专利质量指标的优势。基于这一专利质量指标，本文从专利申请人类型、地域分布和技术分类等角度梳理和归纳了中国1991—2016年期间中国专利质量水平的变化趋势，揭示了中国专利质量全面提升的重要特征事实。在此基础上，利用包含专利质量和数量变化的GDP增长分解框架，探究专利质量上升对中国经济增长的贡献度，发现样本期间内专利质量对经济增长的平均贡献度约为3\%，且其对经济增长的作用相较专利数量呈逐步增强态势。本研究既可为有效评估各类微观主体的专利真实市场价值和自主创新能力提供基础性的识别工具，更可为中国一系列专利制度改革政策及各类科技创新激励政策的绩效评估提供参考依据。}
}

