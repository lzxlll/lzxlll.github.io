{% if site.teachings %}
  <div class="courses">
    {% assign courses_sorted = site.teachings | sort: 'importance' %}
    {% assign institutions = courses_sorted | map: 'category' | uniq %}

    {% for institution in institutions %}
      <h2>{{ institution }}</h2>
      <table class="table table-sm table-borderless">
        <thead>
          <tr>
            <th style="width:35%">Course</th>
            <th style="width:15%">Level</th>
            <th style="width:30%">Period</th>
            <th style="width:20%">Sessions</th>
          </tr>
        </thead>
        <tbody>
          {% for course in courses_sorted %}
            {% if course.category == institution %}
            <tr>
              <td><strong>{{ course.title }}</strong></td>
              <td>{{ course.level }}</td>
              <td>{{ course.period }}</td>
              <td>{{ course.sessions }}</td>
            </tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
    {% endfor %}
  </div>
{% else %}
  <p>No courses available yet.</p>
{% endif %}
